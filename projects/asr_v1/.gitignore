# Generated outputs and runtime state remain local or in Release assets.
__pycache__/
.Xil/
.runtime/
envs/
*.pyc
*.pyo
*.lock
*.part
*.dcp
*.bit
*.ltx
*.elf
*.pth
*.pt
*.zip
*.onnx
*.npz
